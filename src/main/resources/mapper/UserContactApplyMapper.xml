<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="api.meeting.mapper.UserContactApplyMapper">
    <resultMap id="userContactApplyResultMap" type="api.meeting.entity.po.UserContactApply">
        <result column="id" property="id"/>
        <result column="apply_user_id" property="applyUserId"/>
        <result column="receive_user_id" property="receiveUserId"/>
        <result column="last_apply_time" property="lastApplyTime"/>
        <result column="status" property="status"/>
        <result column="nickname" property="nickname"/>
        <result column="user_status" property="userStatus"/>
    </resultMap>
    <!-- 查询用户好友申请列表 -->
    <select id="getUserContactApplyList" resultMap="userContactApplyResultMap" parameterType="java.lang.String">
        SELECT
        uca.*,
        u.username AS nickname,
        u.`status` AS user_status
        FROM
        user_contact_apply uca
        LEFT JOIN `user` u ON uca.receive_user_id = u.id
        WHERE uca.apply_user_id = #{userId}
        ORDER BY uca.last_apply_time DESC
    </select>
</mapper>
